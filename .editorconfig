root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[*.swift]
indent_size = 4

# Read by shfmt (CI runs `shfmt -d scripts`).
[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
space_redirects = true
