{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SDLC_VERIFY": "scripts/verify-docs.sh && scripts/verify-design.sh && cd crocmobile && export GOFLAGS=-tags=croc_no_tailcat && go vet ./... && env -u GOOS -u GOARCH go test -race ./...",
    "SDLC_COMPACT_SUGGEST": "200000",
    "SDLC_COMPACT_REQUIRE": "350000"
  },
  "permissions": {
    "allow": [
      "Bash(.claude/sdlc-scripts/status.sh)",
      "Bash(.claude/sdlc-scripts/status.sh *)",
      "Bash(.claude/sdlc-scripts/next.sh --defaults)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sdlc-plan-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sdlc-commit-gate.sh",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/approval-gate.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sdlc-context-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/sdlc-scripts/status.sh --context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sdlc-context-gate.sh"
          }
        ]
      }
    ]
  }
}
