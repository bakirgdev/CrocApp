{
  "mcpServers": {
    "xcode": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "-y",
        "caveman-shrink",
        "xcrun",
        "mcpbridge"
      ]
    },
    "gopls": {
      "type": "stdio",
      "command": "pnpx",
      "args": [
        "-y",
        "caveman-shrink",
        "sh",
        "-c",
        "exec \"$(go env GOPATH)/bin/gopls\" mcp"
      ]
    }
  }
}
