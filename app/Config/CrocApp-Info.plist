<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bakirgdev.CrocApp.receive</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>crocapp</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bakirgdev.CrocApp.transfer</string>
		<string>com.bakirgdev.CrocApp.transfer.*</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_crocapp._tcp</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Here, not as an INFOPLIST_KEY_ build setting: an sdk-scoped setting
	     still lands in the macOS Info.plist as an empty string, and the QR
	     scanner that needs the camera is iOS-only. -->
	<key>NSCameraUsageDescription</key>
	<string>CrocApp uses the camera to scan the QR code for a code phrase.</string>
	<!-- One transfer runs at a time, so iPad gets one scene. The manifest
	     INFOPLIST_KEY_UIApplicationSceneManifest_Generation writes always
	     says multiple scenes, so the target does not set that key. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- croc's encryption (AES-256-GCM, PAKE) is standard and its source is
	     public, so the app relies on the open-source exemption (EAR 742.15(b),
	     owner decision for 1.0). `true` makes App Store Connect refuse the
	     upload without an ITSEncryptionExportComplianceCode from approved
	     documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
