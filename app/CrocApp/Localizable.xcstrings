{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ + %lld more" : {
      "comment" : "The first placeholder is a file name, the second how many other files the transfer had.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ + %2$lld more"
          }
        }
      }
    },
    "%@ Change it in Settings." : {
      "comment" : "The placeholder is a sentence saying what is wrong with the link server."
    },
    "%@, %@" : {
      "comment" : "A sidebar row's name, then its state. Both placeholders are words.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, receiving %@, %@" : {
      "comment" : "VoiceOver label of a receive that did not finish. The placeholders are Failed, Cancelled or Declined, what was received, and when.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, receiving %2$@, %3$@"
          }
        }
      }
    },
    "%@, sending %@, %@" : {
      "comment" : "VoiceOver label of a send that did not finish. The placeholders are Failed, Cancelled or Declined, what was sent, and when.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, sending %2$@, %3$@"
          }
        }
      }
    },
