// Editor and `pnpm run typecheck` only; docusaurus start/build ignore it.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TS 7 removed baseUrl but the extended config still sets it; `paths` below then resolves from this file.
    "baseUrl": null,
    "paths": { "@site/*": ["./*"] },
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
